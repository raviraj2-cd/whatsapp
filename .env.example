# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# Copy this file to .env.local for Next.js, and .env for standalone scripts/workers
# ==============================================================================

# Application & Runtime
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# Database (MongoDB Atlas / Local)
MONGODB_URI=mongodb://localhost:27017/whatsapp_food_ordering

# NextAuth Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-strong-32-byte-secret-base64-or-hex

# Admin Initial Seed Credentials
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeThisPassword123!
SEED_ADMIN_NAME="System Owner"

# Meta WhatsApp Cloud API
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_permanent_token
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_string
META_APP_SECRET=your_meta_app_secret

# WhatsApp Flows Configuration
# Flow IDs assigned in Meta App Dashboard
FLOW_ID_MENU_ORDER=your_menu_order_flow_id
FLOW_ID_CUSTOM_ORDER=your_custom_order_flow_id
FLOW_ID_VIEW_ORDER=your_view_order_flow_id

# Meta Flow Data Endpoint Encryption (Private Key in PKCS8 / PEM format)
# Ensure newlines are formatted with \n if stored as a single-line env string
FLOW_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----"
FLOW_PASSPHRASE=optional_passphrase_if_encrypted

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecretHere

# Redis & Background Worker / Cron
REDIS_URL=redis://127.0.0.1:6379
CRON_SECRET=custom_secret_to_protect_cron_api_endpoints

# Monitoring & Error Reporting
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
